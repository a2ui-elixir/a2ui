{
  "catalogId": "https://example.com/a2ui/catalogs/restaurant/v1/catalog.json",
  "protocolVersion": "v1.0",
  "title": "Restaurant catalog",
  "description": "Components and functions of the restaurant finder examples, used next to the basic catalog.",
  "instructions": "Show a restaurant's rating with Rating. Ask the agent whether a table is free with checkAvailability. Ask the renderer about the user's locale and time zone with clientInfo.",
  "components": {
    "Rating": {
      "type": "object",
      "description": "A rating shown as stars.",
      "properties": {
        "component": {
          "const": "Rating"
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "The rating, from 0 to max."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 5,
          "description": "The number of stars."
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Text shown after the stars, such as the number of reviews."
        }
      },
      "required": [
        "component",
        "value"
      ]
    }
  },
  "functions": {
    "checkAvailability": {
      "type": "object",
      "description": "Says whether a restaurant has a table for a party at a time. The agent runs it: renderers send it to the agent with callAgentFunction.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "checkAvailability"
        },
        "args": {
          "type": "object",
          "properties": {
            "restaurantId": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "date": {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            "partySize": {
              "$ref": "common_types.json#/$defs/DynamicNumber"
            }
          },
          "required": [
            "restaurantId",
            "date",
            "partySize"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "@call",
        "args"
      ]
    },
    "clientInfo": {
      "type": "object",
      "description": "The renderer's name, the user's locale and the user's time zone. Only the agent calls it, with callRendererFunction.",
      "returnType": "object",
      "allowedCallers": "agentOnly",
      "properties": {
        "@call": {
          "const": "clientInfo"
        },
        "args": {
          "type": "object",
          "properties": {},
          "unevaluatedProperties": false
        }
      },
      "required": [
        "@call"
      ]
    }
  }
}
